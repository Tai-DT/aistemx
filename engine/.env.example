# Chép thành .env rồi điền. Mọi biến đều có mặc định hợp lí — file này chỉ cần
# thiết khi bạn muốn bật phần giải bài bằng mô hình.

# ---- Mô hình ---------------------------------------------------------------
# Bắt buộc nếu muốn dùng /solve. Lấy khoá ở https://console.anthropic.com
AISTEM_ANTHROPIC_API_KEY=

# Model mặc định và model cho bài khó (cờ --heavy / "heavy": true).
AISTEM_MODEL=claude-sonnet-5
AISTEM_MODEL_HEAVY=claude-opus-5

# Lưu kết quả gọi mô hình ra đĩa: giải lại cùng một đề không tốn thêm tiền.
AISTEM_LLM_CACHE=true

# ---- Đường dẫn -------------------------------------------------------------
# Mặc định là thư mục cha của engine/, tức thư mục gốc kho AISTEM.
# AISTEM_CORPUS_ROOT=/Volumes/SecondaryDisk/AISTEM
# AISTEM_DB_PATH=/Volumes/SecondaryDisk/AISTEM/engine/aistem.db

# ---- Truy xuất -------------------------------------------------------------
# Số bản ghi đưa vào ngữ cảnh khi giải một bài.
AISTEM_RETRIEVE_FORMULAS=12
AISTEM_RETRIEVE_LESSONS=4
AISTEM_RETRIEVE_PROBLEMS=4

# ---- Kiểm chứng CAS --------------------------------------------------------
# Trần thời gian cho một phép rút gọn, và cho cả một lượt kiểm chứng (giây).
# Hết giờ thì các bước còn lại ghi rõ là chưa kiểm, không coi như đã kiểm.
AISTEM_CAS_TIMEOUT=4
AISTEM_VERIFY_BUDGET=20
# Sai số tương đối mặc định khi chấm bài điền số.
AISTEM_DEFAULT_TOLERANCE=0.01

# ---- Nhúng vector (tuỳ chọn) ------------------------------------------------
# Để "none" thì tìm kiếm chạy thuần từ khoá — vốn đã đủ tốt cho kho 6 931 bản
# ghi. Bật lên khi muốn tìm theo ngữ nghĩa: none | voyage | openai | gemini
AISTEM_EMBED_PROVIDER=none
AISTEM_EMBED_MODEL=voyage-3.5
AISTEM_EMBED_API_KEY=

# ---- Máy chủ ---------------------------------------------------------------
AISTEM_HOST=127.0.0.1
AISTEM_PORT=8000
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy trong JSON array.
# AISTEM_CORS_ORIGINS=["http://localhost:3000"]
